<?xml version="1.0" encoding="utf-8"?>
<!-- Simple music-note mark on zakka cream. Bounded to the safe 66dp center zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:translateX="24.3"
        android:translateY="24.3">
        <!-- eighth note tail -->
        <path
            android:pathData="M54,30 L54,62"
            android:strokeColor="#8A6D4B"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <!-- note head -->
        <path
            android:fillColor="#C77D5E"
            android:pathData="M54,62 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
        <!-- note head 2 -->
        <path
            android:fillColor="#C77D5E"
            android:pathData="M36,60 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
        <!-- stem to head2 -->
        <path
            android:pathData="M39.5,60 L39.5,36"
            android:strokeColor="#8A6D4B"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <!-- beam connecting stems -->
        <path
            android:pathData="M36.5,32 L54,28"
            android:strokeColor="#C9A227"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
